# ─── steelshelf — configuration ─────────────────────────────────────
# Copy to .env and fill in the secrets. Never commit the real .env.
# A blank key switches off what it buys; the app says so where it matters.

# eBay (Browse API, active listings) ---------------------------------
# Production keyset from https://developer.ebay.com/my/keys. The app mints
# an application (client-credentials) token itself; nothing user-scoped.
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_MARKETPLACE_ID=EBAY_US

# Sold lookups (SerpApi's eBay engine, show_only=Sold) ---------------
# A scraper at one remove, so off by default: the item page's "Look up eBay
# sold prices" button appears only when enabled. Free plan: 250 searches/month,
# one per lookup. Key from https://serpapi.com/manage-api-key.
SOLD_LOOKUP_ENABLED=false
SERPAPI_KEY=
# SoldComps, the same kind of scrape and behind the same switch: with a key,
# sold lookups go here instead of SerpApi (asks still don't). Free plan: 100
# requests/month, one per lookup. Key from https://sold-comps.com.
SOLDCOMPS_KEY=

# Monthly re-price (app/reprice.py) ---------------------------------
# On REPRICE_DAY at REPRICE_HOUR, local, every item not priced since is
# re-priced through the source "Refresh price" uses — so with no eBay keyset
# it runs only while SOLD_LOOKUP_ENABLED is on. With SerpApi it stops with
# REPRICE_RESERVE of the month's searches left for refreshing by hand.
REPRICE_ENABLED=true
REPRICE_DAY=25
REPRICE_HOUR=3
REPRICE_RESERVE=20
# With SOLD_LOOKUP_ENABLED and SOLDCOMPS_KEY, the run looks up sold prices first,
# most valuable items first, spending at most this many SoldComps requests a
# cycle (free plan: 100 a month; the rest stay for the sold button). 0 = asks only.
REPRICE_SOLD_BUDGET=80

# Anthropic (vision identification of front/spine/back photos) --------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
# Claude judges which of a title search's listings are the item's edition, from
# their titles and pictures against the case's front photo: on the worker when
# WORKER_URL is set (its WORKER_JUDGE_MODEL), else the API with JUDGE_MODEL. Off
# by default: each price fetch then makes one more Claude call.
JUDGE_LISTINGS=false
JUDGE_MODEL=claude-haiku-4-5

# Another model instead of Claude (app/chat.py), optional -----------
# AI_PROVIDER=openai sends identify and the listing judge to any OpenAI-
# compatible endpoint in place of the Anthropic key above: OpenAI, OpenRouter
# (https://openrouter.ai/api/v1), Ollama (http://<host>:11434/v1), LM Studio…
# The model must take images. The key may be blank for a local server; a blank
# OPENAI_JUDGE_MODEL judges with OPENAI_MODEL. OPENAI_WEB_SEARCH=true lets the
# model search while identifying, through OpenRouter's search tool (OpenRouter
# only; billed by OpenRouter per search). The worker, if set, is still tried first.
AI_PROVIDER=anthropic
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_JUDGE_MODEL=
OPENAI_WEB_SEARCH=false

# TMDB (genre and director by title, app/film.py) --------------------
# A free key from https://www.themoviedb.org/settings/api:
# the v3 API key, or the longer v4 read access token, which goes as a bearer.
# Blank: nothing is looked up, and genre and director are typed on the edit form.
TMDB_API_KEY=

# Claude Code identify worker (tools/worker.py), optional: Claude Code on your
# own subscription, on a machine logged in to it, tried before the API key
# above. Blank WORKER_URL: the app uses the API only.
WORKER_URL=
WORKER_SECRET=

# App ---------------------------------------------------------------
DATABASE_PATH=./data/steelshelf.db
PHOTO_DIR=./data/photos

# Logging -----------------------------------------------------------
LOG_LEVEL=INFO

# Admin -------------------------------------------------------------
# HTTP Basic for anything that writes the library or calls a third party.
ADMIN_USER=admin
ADMIN_PASSWORD=changeme

# Time zone ---------------------------------------------------------
# Pages show dates in this zone; SQLite stamps are UTC and so is the image.
# Set your own, e.g. Europe/London.
TZ=UTC
