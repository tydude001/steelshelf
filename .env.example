# ─── steelshelf — configuration ─────────────────────────────────────
# Copy to .env and fill in the secrets. Never commit the real .env.
# A blank key switches off what it buys; the app says so where it matters.

# eBay (Browse API, active listings) ---------------------------------
# Production keyset from https://developer.ebay.com/my/keys. The app mints
# an application (client-credentials) token itself; nothing user-scoped.
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_MARKETPLACE_ID=EBAY_US

# Sold lookups (SerpApi's eBay engine, show_only=Sold) ---------------
# A scraper at one remove, so off by default: the item page's "Look up eBay
# sold prices" button appears only when enabled. Free plan: 250 searches/month,
# one per lookup. Key from https://serpapi.com/manage-api-key.
SOLD_LOOKUP_ENABLED=false
SERPAPI_KEY=

# Monthly re-price (app/reprice.py) ---------------------------------
# On REPRICE_DAY at REPRICE_HOUR, local, every item not priced since is
# re-priced through the source "Refresh price" uses — so with no eBay keyset
# it runs only while SOLD_LOOKUP_ENABLED is on. With SerpApi it stops with
# REPRICE_RESERVE of the month's searches left for refreshing by hand.
REPRICE_ENABLED=true
REPRICE_DAY=25
REPRICE_HOUR=3
REPRICE_RESERVE=20

# Anthropic (vision identification of front/spine/back photos) --------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# TMDB (genre and director by title, app/film.py) --------------------
# A free key from https://www.themoviedb.org/settings/api:
# the v3 API key, or the longer v4 read access token, which goes as a bearer.
# Blank: nothing is looked up, and genre and director are typed on the edit form.
TMDB_API_KEY=

# Claude Code identify worker (tools/worker.py), optional: Claude Code on your
# own subscription, on a machine logged in to it, tried before the API key
# above. Blank WORKER_URL: the app uses the API only.
WORKER_URL=
WORKER_SECRET=

# App ---------------------------------------------------------------
DATABASE_PATH=./data/steelshelf.db
PHOTO_DIR=./data/photos

# Logging -----------------------------------------------------------
LOG_LEVEL=INFO

# Admin -------------------------------------------------------------
# HTTP Basic for anything that writes the library or calls a third party.
ADMIN_USER=admin
ADMIN_PASSWORD=changeme

# Time zone ---------------------------------------------------------
# Pages show dates in this zone; SQLite stamps are UTC and so is the image.
# Set your own, e.g. Europe/London.
TZ=UTC
